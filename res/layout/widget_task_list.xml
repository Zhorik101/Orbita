<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:alpha="0.95" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
            <TextView android:id="@id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="3dp" android:text="Задачи" android:textSize="15sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/task_widget_undo" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:text="Отменить" android:textSize="12sp"
                android:gravity="center" android:visibility="gone"/>
            <ImageView android:id="@+id/task_widget_add" android:layout_width="42dp" android:layout_height="match_parent"
                android:src="@drawable/widget_add" android:scaleType="center" android:background="@drawable/widget_presets_background" android:layout_marginEnd="3dp" android:contentDescription="Добавить задачу вручную"/>
            <TextView android:id="@+id/task_widget_presets" android:layout_width="36dp" android:layout_height="match_parent"
                android:gravity="center" android:text="▼" android:textSize="15sp" android:contentDescription="Шаблоны работ"
                android:background="@drawable/widget_presets_background"/>
        </LinearLayout>
        <TextView android:id="@id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="3dp" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
        <LinearLayout android:id="@id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical"/>
        <TextView android:id="@id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="3dp" android:gravity="center_vertical" android:minHeight="22dp"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
